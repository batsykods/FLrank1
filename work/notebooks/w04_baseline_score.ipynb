    "def precision_at_k(scores, labels, k):\n",
    "    frame = pd.DataFrame({\"score\": scores, \"label\": labels})\n",
    "    top = frame.sort_values(\"score\", ascending=False).head(min(k, len(frame)))\n",
    "    return float(top[\"label\"].mean())\n",
    "\n",
    "base_rate = df[\"is_declining_label\"].mean()\n",
    "p50 = precision_at_k(\n",
    "    queue[\"baseline_score\"],\n",
    "    queue[\"is_declining_label\"],\n",
    "    50,\n",
    ")\n",
    "\n",
    "print(\"=== BASELINE CHECK ===\")\n",
    "print(f\"Base rate:       {base_rate:.1%}\")\n",
    "print(f\"Precision@50:    {p50:.1%}\")\n",
    "print(f\"Lift vs base:    {p50 - base_rate:+.1%}\")\n"
   ]
