    "# One transparent rule. No fitted weights and no label-derived inputs.\n",
    "\n",
    "df[\"stale_flag\"] = (df[\"days_since_last_update\"] >= 180).astype(int)\n",
    "df[\"visible_flag\"] = (df[\"impressions_90d\"] >= 300).astype(int)\n",
    "\n",
    "df[\"baseline_score\"] = (\n",
    "    df[\"stale_flag\"]\n",
    "    * df[\"visible_flag\"]\n",
    "    * np.log1p(df[\"impressions_90d\"])\n",
    ")\n",
    "\n",
    "df[\"reason_code\"] = np.where(\n",
    "    df[\"baseline_score\"] > 0,\n",
    "    \"stale_visible\",\n",
    "    \"not_prioritized\",\n",
    ")\n",
    "\n",
    "df[\"action_label\"] = np.where(\n",
    "    df[\"baseline_score\"] > 0,\n",
    "    \"refresh_review\",\n",
    "    \"no_action\",\n",
    ")\n",
    "\n",
    "queue = (\n",
    "    df[\n",
    "        [\n",
    "            \"content_id\",\n",
    "            \"baseline_score\",\n",
    "            \"reason_code\",\n",
    "            \"action_label\",\n",
    "            \"impressions_90d\",\n",
    "            \"days_since_last_update\",\n",
    "            \"is_declining_label\",\n",
    "        ]\n",
    "    ]\n",
    "    .sort_values(\n",
    "        [\"baseline_score\", \"impressions_90d\"],\n",
    "        ascending=[False, False],\n",
    "    )\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "queue[\"rank\"] = np.arange(1, len(queue) + 1)\n",
    "\n",
    "output_dir = repo_root / \"work\" / \"outputs\"\n",
    "output_dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "csv_path = output_dir / \"baseline_action_score.csv\"\n",
    "\n",
    "# CSV intentionally excludes the audit label.\n",
    "queue[\n",
    "    [\n",
    "        \"rank\",\n",
    "        \"content_id\",\n",
    "        \"baseline_score\",\n",
    "        \"reason_code\",\n",
    "        \"action_label\",\n",
    "        \"impressions_90d\",\n",
    "        \"days_since_last_update\",\n",
    "    ]\n",
    "].to_csv(csv_path, index=False)\n",
    "\n",
    "print(f\"Ranked queue written to: {csv_path}\")\n",
    "print(f\"Rows ranked: {len(queue):,}\")\n",
    "print()\n",
    "print(queue.head(10).to_string(index=False))\n"
