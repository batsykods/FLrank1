   "source": [
    "# Signal 1: freshness bucket table\n",
    "\n",
    "freshness_bins = [-np.inf, 30, 90, 180, 365, np.inf]\n",
    "freshness_labels = [\"0-30\", \"31-90\", \"91-180\", \"181-365\", \"365+\"]\n",
    "\n",
    "df[\"freshness_bucket\"] = pd.cut(\n",
    "    df[\"days_since_last_update\"],\n",
    "    bins=freshness_bins,\n",
    "    labels=freshness_labels,\n",
    "    right=True,\n",
    ")\n",
    "\n",
    "freshness_audit = (\n",
    "    df.groupby(\"freshness_bucket\", observed=False)[\"is_declining_label\"]\n",
    "      .agg(n=\"size\", declining_rate=\"mean\")\n",
    "      .reset_index()\n",
    ")\n",
    "\n",
    "print(\"=== SIGNAL 1: DAYS SINCE LAST UPDATE ===\")\n",
    "print(freshness_audit.to_string(index=False))\n",
    "print()\n",
    "\n",
    "# A practical verdict: oldest bucket must have a materially higher decline rate\n",
    "# than the newest bucket, with the direction broadly increasing.\n",
    "rates = freshness_audit[\"declining_rate\"].dropna().to_numpy()\n",
    "if len(rates) >= 2 and rates[-1] > rates[0] and np.corrcoef(np.arange(len(rates)), rates)[0, 1] > 0.3:\n",
    "    freshness_verdict = \"CONFIRMED\"\n",
    "elif len(rates) >= 2 and rates[-1] < rates[0]:\n",
    "    freshness_verdict = \"OPPOSITE\"\n",
    "else:\n",
    "    freshness_verdict = \"MIXED\"\n",
    "\n",
    "print(\"Verdict:\", freshness_verdict)\n"
   ]
