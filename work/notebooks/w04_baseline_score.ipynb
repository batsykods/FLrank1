    "print(f\"Rows: {len(df):,}\")\n",
    "print(f\"Clients: {df['client_id'].nunique():,}\")\n",
    "print(f\"Declining base rate: {df['is_declining_label'].mean():.1%}\")\n",
    "print(\"Note: 2 of 5 buckets are tiny (31-90d n=175, 365+ n=5) — MIXED reflects noise, not a real reversal.\")\n"
